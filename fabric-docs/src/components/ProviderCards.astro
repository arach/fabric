41191 18.6208 5.57467 18.9027 5.80409 18.8412L10.8534 17.4882C11.1011 17.4218 11.3557 17.5688 11.422 17.8165L12.7755 22.8677C12.837 23.0972 13.1625 23.0972 13.224 22.8677L14.5775 17.8165C14.6439 17.5688 14.8984 17.4218 15.1461 17.4882L20.1956 18.8413C20.425 18.9027 20.5878 18.6208 20.4198 18.4529L16.7232 14.7563C16.5419 14.575 16.5419 14.281 16.7232 14.0997L20.419 10.404Z" />
          </svg>
          <span class="provider-card-name provider-card-name--cloud">E2B</span>
          <span class="provider-card-tagline">Data science, Python, rapid prototyping</span>
        </div>
        <a href="https://e2b.dev/dashboard" target="_blank" rel="noopener noreferrer" class="provider-card-link">Get your key →</a>
      </div>
      <ul class="provider-card-features">
        <li>Ultra-fast &lt;200ms cold starts</li>
        <li>Built-in Jupyter kernel</li>
        <li>Claude Code template</li>
      </ul>
      <div class="provider-card-commands">
        <code class="provider-cmd" data-copy>export E2B_API_KEY=your_key</code>
        <code class="provider-cmd" data-copy>fabric create --provider e2b</code>
      </div>
    </div>

    <!-- exe.dev -->
    <div class="provider-card-section provider-card-section--border">
      <div class="provider-card-header">
        <div class="provider-card-title-group">
          <span class="provider-card-name provider-card-name--cloud">exe.dev</span>
          <span class="provider-card-tagline">Persistent VMs, full root access</span>
        </div>
        <a href="https://exe.dev" target="_blank" rel="noopener noreferrer" class="provider-card-link">Learn more →</a>
      </div>
      <ul class="provider-card-features">
        <li>SSH-based (no API key)</li>
        <li>Persistent disk across sessions</li>
        <li>Pre-installed AI agents</li>
      </ul>
      <div class="provider-card-commands">
        <code class="provider-cmd" data-copy>ssh exe.dev</code>
        <code class="provider-cmd" data-copy>fabric create --provider exe</code>
      </div>
    </div>
  </div>
</div>

<style>
  .provider-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 32px 0;
  }

  .provider-card {
    border-radius: 12px;
    overflow: hidden;
  }

  .provider-card--local {
    border: 1px solid rgba(59, 130, 246, 0.2);
    background: linear-gradient(to right, rgba(59, 130, 246, 0.08), rgba(59, 130, 246, 0.03));
    padding: 20px;
  }

  .provider-card--cloud {
    border: 1px solid rgba(16, 185, 129, 0.2);
    background: linear-gradient(to right, rgba(16, 185, 129, 0.08), rgba(16, 185, 129, 0.03));
  }

  .provider-card-section {
    padding: 20px;
  }

  .provider-card-section--border {
    border-top: 1px solid rgba(16, 185, 129, 0.1);
  }

  .provider-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .provider-card-title-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .provider-card-name {
    font-size: 16px;
    font-weight: 600;
  }

  .provider-card-name--local {
    color: #60a5fa;
  }

  .provider-card-name--cloud {
    color: #34d399;
  }

  .provider-card-tagline {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .provider-card-link {
    font-size: 13px;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s;
    white-space: nowrap;
  }

  .provider-card-link:hover {
    color: var(--color-text);
  }

  .provider-card-features {
    list-style: none;
    padding: 0;
    margin: 0 0 12px 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .provider-card-features li {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .provider-card-features li::before {
    content: "•";
    margin-right: 8px;
  }

  .provider-card-commands {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .provider-cmd {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Geist Mono', monospace;
    font-size: 12px;
    background: color-mix(in srgb, var(--color-text) 6%, transparent);
    color: var(--color-text-muted);
    padding: 6px 10px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    width: fit-content;
  }

  .provider-cmd:hover {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-text) 10%, transparent);
  }

  .provider-logo-e2b {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .provider-card-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script is:inline>
  document.querySelectorAll('.provider-cmd[data-copy]').forEach(function(el) {
    el.addEventListener('click', function() {
      var text = el.textContent.trim()
      navigator.clipboard.writeText(text).then(function() {
        var orig = el.textContent
        el.textContent = '✓ Copied!'
        setTimeout(function() { el.textContent = orig }, 1200)
      })
    })
  })
</script>
