---
// Rich provider cards matching the live site treatment
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<div class="provider-cards">
  <!-- Local Section -->
  <div class="provider-card provider-card--local">
    <div class="provider-card-header">
      <div class="provider-card-title-group">
        <span class="provider-card-name provider-card-name--local">Local</span>
        <span class="provider-card-tagline">Development, offline, no cloud costs</span>
      </div>
      <a href={`${base}/local-container`} class="provider-card-link">Setup guide →</a>
    </div>
    <ul class="provider-card-features">
      <li>Apple Virtualization.framework</li>
      <li>No Docker required</li>
      <li>~1s startup</li>
      <li>macOS only</li>
    </ul>
    <div class="provider-card-commands">
      <code class="provider-cmd" data-copy>fabric create --provider local</code>
    </div>
  </div>

  <!-- Cloud Section -->
  <div class="provider-card provider-card--cloud">
    <!-- Daytona -->
    <div class="provider-card-section">
      <div class="provider-card-header">
        <div class="provider-card-title-group">
          <span class="provider-card-name provider-card-name--cloud">Daytona</span>
          <span class="provider-card-tagline">Enterprise teams, TypeScript/Node.js</span>
        </div>
        <a href="https://app.daytona.io" target="_blank" rel="noopener noreferrer" class="provider-card-link">Get your key →</a>
      </div>
      <ul class="provider-card-features">
        <li>Secure network policies & VPC</li>
        <li>TypeScript, Python, Go, Rust</li>
        <li>~2-3s startup</li>
      </ul>
      <div class="provider-card-commands">
        <code class="provider-cmd" data-copy>export DAYTONA_API_KEY=your_key</code>
        <code class="provider-cmd" data-copy>fabric create --provider daytona</code>
      </div>
    </div>

    <!-- E2B -->
    <div class="provider-card-section provider-card-section--border">
      <div class="provider-card-header">
        <div class="provider-card-title-group">
          <svg class="provider-logo-e2b" width="20" height="22" viewBox="0 0 26 28" fill="currentColor">
