{
  "name": "fabric",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @fabric/server dev",
    "runner:dev": "bun run --filter @arach/runner dev",
    "runner:start": "bun run --filter @arach/runner start",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "build:images": "bun run packages/cli/src/cli.ts build --all",
    "ocr:evaluate": "bun run scripts/evaluate-ocr.ts",
    "runner:install": "bash scripts/install-runner.sh",
    "site:dev": "cd landing && bun run dev",
    "site:build": "cd landing && bun run build",
    "site:preview": "cd landing && bun run preview",
    "app:build": "cd app && swift build -c release",
    "app:run": "cd app && swift run Fabric",
    "app:dmg": "bash scripts/build-dmg.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@daytonaio/sdk": "^0.128.1"
  }
}
