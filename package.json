{
  "name": "fabric",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @fabric/server dev",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "ocr:build-image": "container build --progress plain -t fabric-ocr:local -f images/ocr/Dockerfile .",
    "ocr:evaluate": "bun run scripts/evaluate-ocr.ts",
    "runner:install": "bash scripts/install-runner.sh",
    "site:dev": "cd landing && bun run dev",
    "site:build": "cd landing && bun run build",
    "site:preview": "cd landing && bun run preview"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@daytonaio/sdk": "^0.128.1"
  }
}
